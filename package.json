{
  "name": "qroker-kiroween",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest --run",
    "test:ci": "vitest --run --maxWorkers=4",
    "generate:codebook": "tsx scripts/generate-codebook.ts",
    "verify:bound": "tsx scripts/verify-bound.ts",
    "verify:codebook": "tsx scripts/verify-codebook.ts",
    "render:samples": "tsx scripts/render-samples.ts",
    "measure:detection": "tsx scripts/measure-detection.ts",
    "measure:decode-fragment": "tsx scripts/measure-decode-fragment.ts",
    "measure:geometry": "tsx scripts/measure-geometry.ts",
    "merge:geometry": "tsx scripts/merge-geometry.ts",
    "robustness": "tsx scripts/run-robustness.ts",
    "analyze:geometry": "tsx scripts/geometry-failures.ts",
    "analyze:45deg": "tsx scripts/geometry-45deg.ts",
    "verify:geometry": "tsx scripts/verify-geometry-results.ts",
    "collect:decode-counterexamples": "tsx scripts/collect-decode-counterexamples.ts",
    "collect:rejection-counterexamples": "tsx scripts/collect-rejection-counterexamples.ts",
    "check:codebook": "tsx scripts/generate-codebook.ts --check",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:game": "tsc -p tsconfig.game.json",
    "test:game": "vitest --run src/game",
    "dev": "vite",
    "build": "tsc -p tsconfig.game.json --noEmit && vite build",
    "build:standalone": "tsc -p tsconfig.game.json --noEmit && node scripts/build-standalone.mjs",
    "preview": "vite preview",
    "review:openai": "node scripts/openai-review.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "@playwright/test": "1.65.1"
  }
}
